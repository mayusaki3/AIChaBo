{
  "tool": "image.generate",
  "model": "dall-e-3",

  "limits": {
    "n": { "min": 1, "max": 1 },             // 1枚固定など
    "prompt": { "max_bytes": 4000 }
  },

  "allowed": {
    "size": ["1024x1024", "1024x1792", "1792x1024"],
    "quality": ["standard", "hd"],
    "transparent_background": [false]        // 透過非対応なら false のみ
  },

  "defaults": {
    "n": 1,
    "size": "1024x1024",
    "quality": "standard",
    "transparent_background": false
  },

  "aliases": {
    "quality": {
      "vivid": "hd",                          // ユーザー or 別プロバイダの語彙→このモデル語彙に正規化
      "high": "hd",
      "normal": "standard"
    },
    "size": {
      "square": "1024x1024",
      "portrait": "1024x1792",
      "landscape": "1792x1024"
    }
  },

  "coerce_rules": {
    "size": "nearest_allowed",                // 許容外は近い解像度に丸める/エラー
    "quality": "alias_then_error"             // alias で直らなければエラー
  },

  "payload_map": {
    "prompt": "prompt",
    "n": "n",
    "size": "size",
    "quality": "quality",
    "transparent_background": "transparent_background"
  },

  "payload_omit_if_default": ["quality", "n"],// 既定値なら省略してよいフィールド
  "notes": "OpenAI DALL·E 3 向け。将来差分が出たらここを更新。"
}
